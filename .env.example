# Copy to .env (optional). docker compose reads it for variable substitution.
# Safe local defaults only. Never put real credentials here.

# Provider mode. Only "mock" is supported in Week 1; "aws" fails at startup.
PROVIDER_MODE=mock
LOG_LEVEL=INFO

# Host ports (bound to 127.0.0.1 only).
API_HOST_PORT=8000
DB_HOST_PORT=5433
TEST_DB_HOST_PORT=55432

# The API container gets DATABASE_URL from docker-compose.yml
# (postgresql+asyncpg://cloudops:cloudops@db:5432/cloudops, using the Compose
# network hostname "db"). From the host the same database is at
# 127.0.0.1:${DB_HOST_PORT}.
